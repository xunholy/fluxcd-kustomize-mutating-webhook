{
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "separate-pull-requests": false,
  "tag-separator": "-",
  "packages": {
    ".": {
      "package-name": "app",
      "release-type": "go",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "chore",
          "section": "Miscellaneous",
          "hidden": false
        }
      ]
    },
    "deploy/chart/fluxcd-mutating-webhook": {
      "package-name": "helm-chart",
      "release-type": "helm",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "chore",
          "section": "Miscellaneous",
          "hidden": false
        }
      ]
    }
  }
}
